tant;}.simple-menu.menu-items[aria-expanded="true"] {display: block !important;}.simple-menu.menu-items {padding: 10px;background: #fafafa;}.simple-menu .sub-menu {position: static;float: none;visibility: visible;opacity: 1;padding: 0 0 0 20px;background: none;}.simple-menu .sub-menu li {float: none;}.simple-menu .sub-menu a {width: 100%;color: #000000;}.simple-menu > ul > li {float: none;display: block;margin: 0;padding: 0 0 3px 0;}}@media ( min-width:767px ) {.simple-menu li:hover > ul,.simple-menu li.focus > ul,.simple-menu li.menu-hover > ul {opacity: 1;visibility: visible;overflow: visible;}}.isStick{box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.2);}.site-header.boxed .isStick#static-area-header-top > div{max-width: 1200px;}.isStick#menu-primary{background: #FFFFFF;}/*link*/p a {color: #0060a7;}/* Navigation (Menu) */#menu-primary > .menu-items > .menu-item > a {color: #000000;background: #f2f2f2;}#menu-primary > .menu-items > .menu-item > a:before{background: #0060a7;}#menu-primary > .menu-items > .menu-item.current-menu-item > a{background: #0060a7;}#menu-primary .sub-menu .menu-item > a,#menu-primary .cherry-mega-menu-sub > a {color:#000000;font:20px/30px "Russo One", sans-serif;;}#menu-primary .sub-menu .menu-item > a:hover,#menu-primary .sub-menu .menu-item.current-menu-item > a,#menu-primary .cherry-mega-menu-sub > a:hover,#menu-primary .cherry-mega-menu-sub .menu-item.current_page_item > a{color: #0060a8;}#menu-primary a {color: #242424;}#menu-primary a:hover {color: #0060a8;}#menu-primary .sub-menu, #menu-primary .cherry-mega-menu-sub{border-top: 3px solid #0060a7;}#menu-primary .sub-menu, #menu-primary .cherry-mega-menu-sub .mega-block-title {color: 0060a8;}/*menu secondary */#menu-secondary .menu-item > a:hover,#menu-secondary .menu-item.current-menu-item > a {color: #0060a8;}/*mega menu mobile */#menu-primary .cherry-mega-menu-mobile-trigger,#menu-primary .cherry-mega-menu-mobile-close {background: 0060a8;}#menu-primary .cherry-mega-menu-mobile-trigge