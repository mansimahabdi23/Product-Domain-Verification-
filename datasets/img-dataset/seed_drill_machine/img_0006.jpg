          if (e.which == "2" || e.which == "3") {
               alert('Unauthorized duplication, copying and use of published photographs and images, albeit unofficially, constitutes a crime according to the Law No. 5846 on Intellectual and Artistic Works.All rights reserved.MATTERHORN');
