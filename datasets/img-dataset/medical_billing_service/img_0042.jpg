    <style>
    .error-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        position: relative;
        overflow: hidden;
    }

    .error-page::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(108, 99, 255, 0.1) 0%, transparent 70%);
        animation: float 20s ease-in-out infinite;
        z-index: 0;
    }

    .error-page::after {
        content: '';
        position: absolute;
        bottom: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255, 107, 107, 0.1) 0%, transparent 70%);
        animation: float 15s ease-in-out infinite reverse;
        z-index: 0;
    }

    @keyframes float {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        25% { transform: translate(10px, 10px) rotate(1deg); }
        50% { transform: translate(-5px, 20px) rotate(-1deg); }
        75% { transform: translate(-15px, 5px) rotate(1deg); }
    }

    .error-container {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 600px;
        padding: 3rem 2rem;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .error-number {
        font-size: clamp(6rem, 15vw, 12rem);
        font-weight: 700;
        margin-bottom: 1rem;
        background: linear-gradient(45deg, #6c63ff, #ff6b6b, #4ecdc4);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
        line-height: 1;
    }

    @keyframes gradientShift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }

    .error-title {
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        font-weight: 600;
        margin-bottom: 1rem;
        color: #333;
    }

    .error-description {
        font-size: clamp(1rem, 2.5vw, 1.2rem);
        color: #666;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .error-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .btn-primary-error {
        display: inline-block;
        padding: 1rem 2rem;
        background: linear-gradient(45deg, #6c63ff, #5a52e0);
        color: white;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(108, 99, 255, 0.3);
        border: none;
        cursor: pointer;
        min-width: 200px;
    }

    .btn-primary-error:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 35px rgba(108, 99, 255, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-secondary-error {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        background: transparent;
        color: #6c63ff;
        text-decoration: none;
        border: 2px solid #6c63ff;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        min-width: 150px;
    }

    .btn-secondary-error:hover {
        background: #6c63ff;
        color: white;
        text-decoration: none;
        transform: translateY(-2px);
    }

    .search-suggestions {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid #eee;
    }

    .search-suggestions h4 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        color: #333;
    }

    .suggestion-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .suggestion-link {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #f8f9fa;
        color: #6c63ff;
        text-decoration: none;
        border-radius: 25px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

    .suggestion-link:hover {
        background: #6c63ff;
        color: white;
        text-decoration: none;
        transform: translateY(-1px);
    }

    /* Mobile Responsive Adjustments */
    @media (max-width: 768px) {
        .error-page {
            min-height: 70vh;
            padding: 1rem;
        }

        .error-container {
            padding: 2rem 1.5rem;
            margin: 1rem;
        }

        .error-actions {
            gap: 0.8rem;
        }

        .btn-primary-error {
            padding: 0.9rem 1.8rem;
            font-size: 1rem;
            min-width: 180px;
        }

        .btn-secondary-error {
            padding: 0.7rem 1.3rem;
            font-size: 0.9rem;
            min-width: 140px;
        }

        .suggestion-links {
            gap: 0.4rem;
        }

        .suggestion-link {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }
    }

    @media (max-width: 480px) {
        .error-container {
            padding: 1.5rem 1rem;
        }

        .error-number {
            font-size: clamp(4rem, 20vw, 8rem);
        }

        .error-title {
            font-size: clamp(1.2rem, 5vw, 1.8rem);
        }

        .error-description {
            font-size: clamp(0.9rem, 3vw, 1.1rem);
        }
    }

    /* Ensure proper spacing with header */
    .header-area {
        margin-bottom: 0 !important;
    }

    /* Fix for any potential layout conflicts */
    .main-content {
        min-height: calc(100vh - 200px);
    }
</style>

</head>
