     /* .top-bar-btn animation */
    .top-bar-btn {
        animation-name: borderPulse;
        -webkit-animation-name: pulseBtn;
        -moz-animation-name: pulseBtn;
        animation-name: borderPulse;
        -webkit-animation-duration: 1s;
        -moz-animation-duration: 1s;
        animation-duration: 1s;
        -webkit-animation-iteration-count: infinite;
        -moz-animation-iteration-count: infinite;
        animation-iteration-count: infinite;
    }
    @keyframes borderPulse {
        0% {
            box-shadow: 0 0 0 0 #203993;
        }
        100% {
            box-shadow: 0 0 0 8px rgba(32, 57, 147, 0);
        }
    }
    .appointment-btn {
        animation-name: borderPulseApt;
        -webkit-animation-name: pulseBtn;
        -moz-animation-name: pulseBtn;
        animation-name: borderPulseApt;
        -webkit-animation-duration: 1s;
        -moz-animation-duration: 1s;
        animation-duration: 1s;
        -webkit-animation-iteration-count: infinite;
        -moz-animation-iteration-count: infinite;
        animation-iteration-count: infinite;
    }
    @keyframes borderPulseApt {
        0% {
            box-shadow: 0 0 0 0 #fc5d61;
        }
        100% {
            box-shadow: 0 0 0 8px rgba(252, 93, 97, 0);
        }
    }
