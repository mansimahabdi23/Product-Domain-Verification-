<script>
    $(document).ready(function() {
        $('.SelectDate').datepicker({
            format: 'mm-dd-yyyy',
            autoclose: true,
            todayHighlight: true,
            startDate: new Date(),
            beforeShowDay: function(date) {
                var today = new Date();
                today.setHours(0, 0, 0, 0);
                var day = date.getDay();
                if (day === 0 || day === 6) {
                    // Style weekends and disable selection
                    return {
                        enabled: false,
                        classes: 'non-highlighted-date'
                    };
                }
                if (date >= today) {
                    return {
                        enabled: true,
                        classes: 'highlighted-date'
                    };
                }
                // Disable past weekdays
                return {
                    enabled: false,
                    classes: 'non-highlighted-date'
                };
            }
        });
    });
</script>

