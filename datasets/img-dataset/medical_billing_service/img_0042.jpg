<script src="https://medsitnexus.com/assets/js/jquery/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.21.0/dist/sweetalert2.all.min.js"></script>


<script>
    $.ajaxSetup({
        headers: {
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        }
    });
    $(document).on('submit', '.bookConsultation', function(e){
        e.preventDefault();
        const RECAPTCHA_SITE_KEY = '6LefRqsnAAAAAFqUlE8X_KchYRf3ejbO-RoSHime';
        let form = this;
        let formData = new FormData(this);
        let submitButton = $(form).find('button[type="submit"]');
        // change button text and disable it
        submitButton.prop('disabled', true).text('Booking your appointment...');

         grecaptcha.ready(function(){
            grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'submit_form' }).then(function(token){
                formData.append('recaptcha_token', token);
                formData.append('recaptcha_action', 'submit_form');
                $.ajax({
                    url: '/consultation',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res){
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            text: res.message ?? 'Thank you for contacting us, we will get back to you shortly!',
                            icon: "success",
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                        });
                        form.reset();
                        submitButton.prop('disabled', false).text('Book a Free Consultation');
                    },
                    error: function(xhr) {
                        submitButton.prop('disabled', false).text('Book a Free Consultation');
                        if (xhr.status === 422 && xhr.responseJSON.errors) {
                            let errors = xhr.responseJSON.errors;
                            let messages = Object.values(errors).flat().join('\n');
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                text: messages,
                                icon: 'error',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true,
                            });
                        }else{
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                text: 'Something\'s not quite right. Please try again.',
                                icon: 'error',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true,
                            });
                        }
                    }
                });
            });
        });
    });

    // Appointment form submission
    $(document).on('submit', '.appointmentFormUpdate', function(e){
        e.preventDefault();
        const RECAPTCHA_SITE_KEY = '6LefRqsnAAAAAFqUlE8X_KchYRf3ejbO-RoSHime';
        let form = this;
        let formData = new FormData(this);
        let submitButton = $(form).find('button[type="submit"]');
        submitButton.prop('disabled', true).text('Confirming...');
        grecaptcha.ready(function(){
            grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'submit_form' }).then(function(token){
                formData.append('recaptcha_token', token);
                formData.append('recaptcha_action', 'submit_form');
                $.ajax({
                    url: 'book-an-appointment',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            timer: 5000,
                            title: 'Successfully Submitted!',
                            text: res.message ?? 'Appointment booked successfully!',
                            icon: "success",
                        });
                        form.reset();
                        submitButton.prop('disabled', false).text('Confirm');
                    },
                    error: function(xhr) {
                        submitButton.prop('disabled', false).text('Confirm');

                        // Handle server-side validation errors (including time slot conflicts)
                        if (xhr.status === 422) {
                            let errorMessage = '';

                            // Check if it's a custom error message (like time slot conflict)
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMessage = xhr.responseJSON.message;
                            }
                            // Check if it's validation errors
                            else if (xhr.responseJSON && xhr.responseJSON.errors) {
                                let errors = xhr.responseJSON.errors;
                                errorMessage = Object.values(errors).flat().join('\n');
                            }

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                timer: 7000,
                                title: 'Time Slot Unavailable',
                                text: errorMessage || 'Please check your selection and try again.',
                                icon: 'error',
                                showConfirmButton: true,
                                confirmButtonText: 'OK',
                            });
                        } else {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                timer: 5000,
                                text: 'Something\'s not quite right. Please try again.',
                                icon: 'error',
                                showConfirmButton: false
                            });
                        }
                    }
                });
            });
        });
    });
</script>
<script>
    $("#providersForm").on("submit", function(event) {
        event.preventDefault();
        var form = $(this);
        var submitButton = form.find('button[type="submit"]');
        submitButton.prop('disabled', true).text('Submitting...');
        $(document).find('div.preloader').removeClass('preloader-deactivate');
        grecaptcha.ready(function() {
            grecaptcha.execute('6LefRqsnAAAAAFqUlE8X_KchYRf3ejbO-RoSHime', {action: 'providers_post'}).then(function(token) {
                var formData = form.serializeArray();
                formData.push({ name: "g-recaptcha-response", value: token });
                $.ajax({
                    type: 'POST',
                    url: 'providers-post',
                    data: formData,
                    success: function(res) {
                        Swal.fire({
                            title: 'Successfully Submitted!',
                            text: res.message ?? 'Thank you for contacting us, we will get back to you shortly!',
                            icon: "success",
                            showConfirmButton: false,
                            timer: 3000
                        });
                        form[0].reset();
                        submitButton.prop('disabled', false).text('Submit');
                    },
                    error: function(xhr) {
                        submitButton.prop('disabled', false).text('Submit');
                        if (xhr.status === 422 && xhr.responseJSON.errors) {
                            let errors = xhr.responseJSON.errors;
                            let messages = Object.values(errors).flat().join('\n');
                            Swal.fire({
                                title: 'Validation Error',
                                icon: 'error',
                                text: messages || 'Validation error occured.',
                                showConfirmButton: false,
                                timer: 5000
                            });
                        } else {
                            Swal.fire({
                                title: 'Uh-oh!',
                                icon: 'error',
                                text: 'Something\'s not quite right. Please try again later.',
                                showConfirmButton: false,
                                timer: 4000
                            });
                        }
                    }
                });
            });
        });
    });


    $("#subscription-form").on("submit", function(event) {
        $(document).find('div.preloader').removeClass('preloader-deactivate');
        if (event.isDefaultPrevented()) {
            formError('#subscription-form');
            submitMSG(false, "Please fill in the required fields");
        } else {
            event.preventDefault();
            submitForm('newsletter-post', '#subscription-form');
        }
    });

    $("#newsletter-form").on("submit", function(event) {
    setTimeout(function() {
            $('.alert-dismissible').alert('close');
        }, 4000);
    
        $(document).find('div.preloader').removeClass('preloader-deactivate');
        if (event.isDefaultPrevented()) {
            formError('#newsletter-post');
            submitMSG(false, "Please fill in the required fields");
        } else {
            event.preventDefault();
            submitForm('newsletter-post', '#newsletter-form');
        }
    });

    $("#newsletter-form-top").on("submit", function(event) {
        $(document).find('div.preloader').removeClass('preloader-deactivate');
        if (event.isDefaultPrevented()) {
            formError('#newsletter-post');
            submitMSG(false, "Please fill in the required fields");
        } else {
            event.preventDefault();
            submitForm('newsletter-post', '#newsletter-form-top');
        }
    });

    function formSuccess(container, msg) {
        $(container)[0].reset();
        if (container == '#providersForm') {
            $(container + ' #providers').html('');
            $(container + ' #hi').html('');
            $(container + ' .our-help').val('');
        }
        submitMSG(true, msg, container);
    }

    function formError(container) {
        $(container).removeClass().addClass('shake animated').one('webkitAnimationEnd mozAnimationEnd MSAnimationEnd oanimationend animationend', function () {
            $(this).removeClass();
        });
    }

    function submitMSG(valid, msg, container) {
    
        var msgClasses = ''
        var alert_class = '';
        if (valid) {
            alert_class = "alert-success";
            msgClasses = "h6 text-success text-center";
            // setTimeout(function () {
                $(container + " .alert").removeClass("d-none");
                $('.modal').modal('hide');
                $(".modal .close").click();
            // }, 3000);
        } else {
            msgClasses = "h6 text-danger text-center";
            alert_class = 'alert-danger';
        }
        console.log(msg);
        $(container + " #msgSubmit").removeClass().addClass(msgClasses).text(msg);
        $(container + " #msgSubmit").parent().addClass(alert_class);
            setTimeout(function() {
            $(container + " #msgSubmit").removeClass().removeClass(msgClasses).text('');
            $(container + " #msgSubmit").parent().removeClass(alert_class).addClass('d-none');
                    }, 4000);
    
    }

    $("#appointment_btn").on("click", function (event) {
        var check_status = $("input[name='agreed']").is(':checked');
    
    if (!check_status) {
        $('#check1').siblings('span.text-danger').text('Please check the box if you want to proceed.');
        return false;
    }
    $('#check1').siblings('span.text-danger').text('');
        if (event.isDefaultPrevented()) {
            formError('#appointmentForm');
            submitMSG(false, "Please fill in the required fields");
        } else {
            event.preventDefault();
            submitForm('appointment-post', '#appointmentForm');
        }
        $("#appointment_btn").attr('disabled',true).prepend('<i class="fa fa-spinner fa-spin"></i>');
    });

    function submitForm(url, container) {
        $(container + " input, textarea").each(function (i, e) {
            // if (!($(e).attr("type") == "radio")) {
            //     if ($(e).next().find("span")) {
            //         $(e).next().remove();
            //     }
            // }
        });

        $(container + ' input[type="submit"]').prop('disabled', true);
        var pre_value=$(container + ' input[type="submit"]').val();
        $(container + ' input[type="submit"]').val("Submitting");
        // Show the spinner
        $(document).find('div.preloader').removeClass('preloader-deactivate');

        let form_data = $(container).serialize();
        let csrfToken = $('meta[name="csrf-token"]').attr("content");

        $.ajax({
            type: "POST",
            url: window.base_url + url,
            data: form_data,
            beforeSend: function (xhr) {
                xhr.setRequestHeader("X-CSRF-TOKEN", csrfToken);
            },
            success: function (resp) {
            // setTimeout(function() {
            //             $(".alert-success").alert('close');
            //         }, 4000);
            $('html, body').animate({ scrollTop: 0 });
            $("#appointment_btn").attr('disabled',false).find('i.fa-spinner').remove();
            $("#appointmentForm #step1").show();
                $("#appointmentForm #step2").hide();
                $("#appointmentForm #step3").hide();
                window.currentStep = 1;
                if (resp.status === "success") {
                    formSuccess(container, resp.message);
                } else {
                    console.log('error=',resp);
                    formSuccess(container, resp.message);
                    formError(container);

                    submitMSG(false, resp.message);
                }
                $(document).find('div.preloader').addClass('preloader-deactivate');
                $(container + ' input[type="submit"]').prop('disabled', false);
                $(container + ' input[type="submit"]').val(pre_value);
            },
            error: function (resp) {
                $(container + ' input[type="submit"]').val(pre_value);
                $(container + ' input[type="submit"]').prop('disabled', false);
                $(document).find('div.preloader').addClass('preloader-deactivate');
                if (container == "#appointmentForm") {
                $("#appointmentForm").find('span').remove();
                    $("#appointmentForm #step1").show();
                    $("#appointmentForm #step2").hide();
                    $("#appointmentForm #step3").hide();
                    window.currentStep = 1;
                }

                $.each(resp.responseJSON.errors, function (field_name, error) {
                    $(container + ' input[type="submit"]').prop('disabled', false);
                $(container + ' input[type="submit"]').val(pre_value);
                    let field = $(document).find(container + ' [name="' + field_name + '"]');

                    if (
                        field_name == "appointment_date" ||
                        field.attr("type") == "radio"
                    ) {
                        field
                            .parent()
                            .after(
                                '<span class="text-strong text-danger">' +
                                error +
                                "</span>"
                            );
                        field.parent().css("margin-bottom", "0");
                        field.parent().find("span").remove();
                    } else {
                        if (container == '#newsletter-form-top' || container == '#newsletter-form') {
                            $(container + ' .input').after(
                                '<span class="text-strong text-danger" style="align-items: start; display: flex; margin-left: 5px;">' +
                                error +
                                "</span>"
                            );
                        } else {
                            field.after(
                                '<span class="text-strong text-danger">' +
                                error +
                                "</span>"
                            );
                        }
                    }
                });
            },
        });

        $(document).find('div.preloader').addClass('preloader-deactivate');
    }
</script>
