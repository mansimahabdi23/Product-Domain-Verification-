<script>
jQuery(document).ready(function ($) {

    // First filter
    $('#filter').on('keyup', function () {
        let curr_text = $(this).val().toLowerCase();

        $('.header-main .search-menu').each(function () {
            let itemText = $(this).text().toLowerCase();

            $(this).toggle(itemText.indexOf(curr_text) > -1);
        });
    });

    // Second filter
    $('#filter-2').on('keyup', function () {
        let curr_text = $(this).val().toLowerCase();

        $('.search-menu-2').each(function () {
            let itemText = $(this).text().toLowerCase();

            $(this).toggle(itemText.indexOf(curr_text) > -1);
        });
    });

});
	
document.addEventListener('wpcf7mailsent', function (event) {

           // Get hidden field value
        const pdfInput = event.target.querySelector('input[name="acf_value"]');

        if (pdfInput && pdfInput.value) {
            const link = document.createElement("a");
            link.href = pdfInput.value;
            link.download = pdfInput.value.split('/').pop(); // optional: sets file name
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

}, false);

	
</script>
<script>
document.addEventListener("input", function (e) {
  if (!e.target.classList.contains("cf7-phone-autofmt")) return;

  let value = e.target.value;
  let numbers = value.replace(/\D/g, "").slice(0, 10);

  let formatted = numbers;

  if (numbers.length >= 4 && numbers.length <= 6) {
    formatted = numbers.slice(0, 3) + "-" + numbers.slice(3);
  } else if (numbers.length >= 7) {
    formatted =
      numbers.slice(0, 3) + "-" +
      numbers.slice(3, 6) + "-" +
      numbers.slice(6);
  }

  if (formatted !== value) {
    e.target.value = formatted;
  }
});
</script>

<script type="text/javascript">
window.addEventListener("load", function(event) {
jQuery(".cfx_form_main,.wpcf7-form,.wpforms-form,.gform_wrapper form").each(function(){
var form=jQuery(this); 
var screen_width=""; var screen_height="";
 if(screen_width == ""){
 if(screen){
   screen_width=screen.width;  
 }else{
     screen_width=jQuery(window).width();
 }    }  
  if(screen_height == ""){
 if(screen){
   screen_height=screen.height;  
 }else{
     screen_height=jQuery(window).height();
 }    }
form.append('<input type="hidden" name="vx_width" value="'+screen_width+'">');
form.append('<input type="hidden" name="vx_height" value="'+screen_height+'">');
form.append('<input type="hidden" name="vx_url" value="'+window.location.href+'">');  
}); 

});
</script> 

