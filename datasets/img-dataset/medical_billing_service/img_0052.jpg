.home-form .con-div {
    display: flex;
    gap: 16px;
    justify-content: space-around;
	width:100%;
	padding-bottom: 24px;
}

.home-form .con-div .con-inner {
    width: 100%;
}

.home-form input, .home-form textarea, .home-form select{
padding-right: 12px;
border-radius: 8px;
border: 0.8px solid #F3F3F5;
	background-color: #F3F3F5;
outline: none !important;
	font-size:14px;
	width:100%;
}

.elementor-shortcode{
	width:100%;
}
.home-form label {
    font-family: Nunito Sans;
    font-weight: 500;
    font-size: 14px;
    line-height: 14px;
    letter-spacing: 0px;
	color: #0A0A0A;
}

.home-form  input.wpcf7-form-control.wpcf7-submit.has-spinner{
	background-color:#467FF7;
	 margin-top: 24px;
}

.home-form  input.wpcf7-form-control.wpcf7-submit.has-spinner:hover{
	border:none;
	outline:none;
	color:#ffffff;
	background-color:#2b6efa;
}

.home-faq details {
    padding-top: 0.8px;
    padding-right: 24.8px;
    padding-bottom: 0.8px;
    padding-left: 24.8px;
    border-radius: 10px;
    border-width: 0.8px;
    border: 1px solid #E5E7EB;
    background-color: #ffffff;
}

.line-after {
    position: relative;
}
.line-after:after {
    content: "";
    width: 35px;
    height: 2px;
    position: absolute;
    top: 45px;
    right: -34px;
    background: #155DFC;
    z-index: 0;
}

.main-heading-div{
	max-height: 280px;
    overflow: hidden;
    overflow-y: scroll;
}

   @media (max-width: 1024px) {
		 .line-after:after{
			 display:none;
		 }
}
   @media (max-width: 767px) {
		 br {
			 display:none;
		 }
		 .br-display br {
			 display:block;
		 }
		 .home-form .con-div{
			 flex-direction: column;
		 }
    }

.e-n-accordion-item-title-text:hover{
	       border:none;
	outline:none;
	    text-decoration: underline;
}
.main-testimontiona-div {
    min-height: 530px;
}

@media (min-width: 1024px) {
  .e-n-accordion-item-title-text:hover{
    border: none;
    outline: none;
    text-decoration: underline;
		color:#467FF7;
  }
}
@media only screen and (min-width: 1024px) {
  /* Desktop hover */
  .e-n-accordion-item-title-text:hover{
    border: none;
    outline: none;
    text-decoration: underline;
				color:#467FF7;

  }
}

p#countText {
    color: #64748B;
    font-size: 14px;
    line-height: 20px;
}

@media screen and (min-width: 1025px) and (max-width: 1300px) {
  .elementor-641 .elementor-element.elementor-element-83b61cc .elementor-button {
    font-size: 9px;
    font-weight: 500;
    line-height: 20px;
    border-radius: 8px 8px 8px 8px;
    padding: 10px 10px 10px 10px;
	}
	header .e-con.e-flex>.e-con-inner{
		max-width: 97%;
	}
	header .elementor-widget-n-menu .e-n-menu-heading{
		justify-content: flex-end;
	}
	header .elementor-widget-n-menu .e-n-menu-title-text{
		font-size: 12px;
	}
}




