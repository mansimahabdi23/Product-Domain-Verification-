			<meta name="generator" content="Elementor 3.35.5; features: e_font_icon_svg, additional_custom_breakpoints; settings: css_print_method-internal, google_font-enabled, font_display-swap">
<script>
jQuery(document).ready(function($){

    let blogs = $(".my-blog .e-loop-item");
    let total = blogs.length;     // Total articles
    let showCount = 9;            // First show only 9
    let loadMoreCount = 3;        // Show 3 on each click

    // Initially hide all
    blogs.hide();

    // Show first 9
    blogs.slice(0, showCount).show();

       updateCount();

    $("#loadMore a").click(function () {
        showCount += loadMoreCount;

        blogs.slice(0, showCount).slideDown();

         updateCount();

        // Hide button when all blogs shown
        if (showCount >= total) {
            $("#loadMore a").hide();
        }
    });

    // Update text: Showing X of Y articles
    function updateCount(){
        let visible = blogs.filter(":visible").length;
        $("#countText").text("Showing " + visible + " of " + total + " articles");
    }

});
</script>
