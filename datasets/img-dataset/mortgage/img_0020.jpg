<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>403 — Forbidden</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 0; padding: 48px; }
    .card { max-width: 760px; margin: 0 auto; padding: 28px; border: 1px solid #e5e7eb; border-radius: 16px; }
    h1 { margin: 0 0 12px; font-size: 24px; }
    p { margin: 0 0 10px; color: #374151; line-height: 1.5; }
    code { background: #f3f4f6; padding: 2px 6px; border-radius: 6px; }
    .small { color: #6b7280; font-size: 13px; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>403 - Forbidden</h1>
    <p>You don’t have permission to access this resource.</p>
  </div>
</body>
</html>