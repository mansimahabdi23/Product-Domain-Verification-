<div class="login-wrapper">
    <div class="login">
        <button class="icon-button icon-button--login" id="LoginButton" data-toggle="dropdown" aria-label="Toggle login dialog"><span class="open_text" aria-hidden="true">Log&nbsp;in</span><span class="close_text" aria-hidden="true">Close</span></button>
        <div class="login__menu dropdown-menu">
            <a href="javascript:void(0);" class="login-close" id="login-close"><i class="fa fa-times"><span class="sr-only">Close Login Menu</span></i></a>
            <div class="login__header">Welcome</div>
            <div class="login__subheader">Log in to online banking</div>
            <form mautocomplete="off" id="Login" name="Login" method="post" action="https://www.clearviewfcuib.org/auth-olb/live/v1/remote-login">
                <input type="hidden" id="testcookie" name="testcookie" value="false" />
                <input type="hidden" id="testjs" name="testjs" value="false" />
                <input type="hidden" id="dscheck" name="dscheck" value="0" />
                <div class="form-group">
                    <label class="sr-only" for="userid">User</label>
                    <input type="text" class="form-control" placeholder="Username" id="userid" name="userid" size="16" maxlength="256" value="">
                </div>
                <div class="form-group">
                    <label class="sr-only" for="password">Password</label>
                    <input type="password" id="password" class="form-control" placeholder="Password" name="password" size="16" maxlength="32" value="">
