<!--script>
document.addEventListener('DOMContentLoaded', function() {
  function initScrollAnimations() {
    // Check if GSAP is loaded
    if (typeof gsap === 'undefined') {
      return;
    }
    
    // Register ScrollTrigger plugin
    if (typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
    }
    
    const sections = document.querySelectorAll('[data-scroll-animation="section"]');
    if (!sections.length) return;
    
    sections.forEach(section => {
      const heading = section.querySelector('[data-scroll-animation="heading"]');
      const bodies = section.querySelectorAll('[data-scroll-animation="body"]');
      
      if (!heading && !bodies.length) return;
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
          toggleActions: 'play none none none',
          once: true,
        }
      });
      
      if (heading) {
        tl.to(heading, {
          visibility: 'visible',
          filter: 'blur(0px)',
          opacity: 1,
          duration: 1.2,
          ease: 'power2.out'
        });
      }
      
      if (bodies.length) {
        tl.to(bodies, {
          opacity: 1,
          duration: 1,
          ease: 'power2.out',
          stagger: { amount: 0.4, from: 'start' }
        }, '-=0.6');
      }
    });
  }
  
  initScrollAnimations();
});
</script-->

