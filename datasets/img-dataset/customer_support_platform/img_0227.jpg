        y: 0,
        duration: 0.8,
        ease: 'power2.out'
      }, `-=${delay}`);
    });
  }
  
  initHeroAnimation();
});
</script-->

<!-- ========================================
     SCRIPT 3: BUTTON HOVER EFFECTS
     ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function initHoverEffects() {
    let isInitialized = false;
    let cleanupFns = [];
    
    function setupHoverAnimation() {
      const buttons = document.querySelectorAll('.button');
      if (!buttons.length) return;

      buttons.forEach((button) => {
        const originalText = button.querySelector('.hover-text');
        if (!originalText || typeof SplitText === 'undefined') return;

        try {
          const originalSplit = new SplitText(originalText, { type: "chars" });
          const clonedText = originalText.cloneNode(true);
          clonedText.classList.add('cloned-text');
          clonedText.setAttribute("aria-hidden", "true");
          button.appendChild(clonedText);

          const clonedSplit = new SplitText(clonedText, { type: "chars" });

          gsap.set(clonedText, {
            position: "absolute",
            top: "auto",
            left: 0,
            width: "100%",
            pointerEvents: "none"
          });

          gsap.set(clonedSplit.chars, { y: '100%' });
          gsap.set(originalSplit.chars, { y: '0%' });

          const onEnter = () => animateChars(originalSplit.chars, '-100%', clonedSplit.chars, '0%');
          const onLeave = () => animateChars(originalSplit.chars, '0%', clonedSplit.chars, '100%');

          button.addEventListener('mouseenter', onEnter, { passive: true });
          button.addEventListener('mouseleave', onLeave, { passive: true });

          cleanupFns.push(() => {
            button.removeEventListener('mouseenter', onEnter);
            button.removeEventListener('mouseleave', onLeave);
            if (button.contains(clonedText)) button.removeChild(clonedText);
            originalSplit.revert();
            clonedSplit.revert();
          });
        } catch (error) {
          console.warn('Hover animation setup failed:', error);
        }
      });
    }

    function animateChars(chars1, y1, chars2, y2) {
      gsap.to(chars1, { y: y1, duration: 0.3, ease: 'power2.inOut', stagger: 0.02 });
      gsap.to(chars2, { y: y2, duration: 0.3, ease: 'power2.inOut', stagger: 0.02 });
    }

    function checkScreenSize() {
      const isLarge = window.innerWidth > 991;
      if (isLarge && !isInitialized) {
        setupHoverAnimation();
        isInitialized = true;
      } else if (!isLarge && isInitialized) {
        cleanupFns.forEach(fn => fn());
        cleanupFns = [];
        isInitialized = false;
      }
    }

    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(checkScreenSize, 150);
    }, { passive: true });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(checkScreenSize);
    } else {
      setTimeout(checkScreenSize, 100);
    }
  }
  
  initHoverEffects();
});
</script>

<!-- ========================================
     SCRIPT 4: NUMBER COUNTERS
     ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function initNumberCounters() {
    const elements = document.querySelectorAll('[counter-element="number"]');
    if (!elements.length) return;
    
    const animateNumber = (element, target, duration) => {
      const easingFunction = t => t * t * (3 - 2 * t);
      let startTime = null;

      const animate = time => {
        if (!startTime) startTime = time;
        const progress = Math.min((time - startTime) / duration, 1);
        const value = Math.floor(target * easingFunction(progress));
        
        element.textContent = value;
        
        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          element.textContent = target;
        }
      };
      
      requestAnimationFrame(animate);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const finalNumber = parseInt(el.textContent, 10);
          const duration = parseInt(el.getAttribute('data-duration'), 10) || 2000;
          
          animateNumber(el, finalNumber, duration);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.1 });

    elements.forEach(el => observer.observe(el));
  }
  
  initNumberCounters();
});
</script>

<!-- ========================================
     SCRIPT 5: SWIPER SLIDER
     ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function initSwiper() {
    const swiperEl = document.querySelector('.swiper.is-sstories');
    if (!swiperEl || typeof Swiper === 'undefined') {
      console.warn('Swiper element not found or Swiper library not loaded');
      return;
    }
    
    try {
      new Swiper(swiperEl, {
        slidesPerView: 'auto',
        spaceBetween: 32,
        navigation: {
          nextEl: '.swiper-next',
          prevEl: '.swiper-prev',
          disabledClass: 'is-swiper-disable'
        },
        breakpoints: {
          0: { spaceBetween: 16 },
          478: { spaceBetween: 32 }
        },
        simulateTouch: true,
        touchEventsTarget: 'container',
        mousewheel: {
          forceToAxis: true,
          sensitivity: 0.3,
          releaseOnEdges: true,
          thresholdDelta: 30,
          thresholdTime: 200,
        },
      });
    } catch (error) {
      console.warn('Swiper initialization failed:', error);
    }
  }
  
  initSwiper();
});
</script>

<!-- ========================================
     SCRIPT 6: TAB SYSTEM
     ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function initTabSystem() {
    const panes = document.querySelectorAll(".y-tab_pane, .x-tab_pane");
    const closeButtons = document.querySelectorAll(".y-tab_close-mobile, .x-tab_close-mobile, .tab-modal_close-button");
    
    if (!panes.length) return;
    
    const body = document.body;
    const isMobile = () => window.innerWidth <= 991;
    
    const setPaneActive = (pane, active) => {
      pane.classList.toggle("active", active);
      pane.style.display = active ? "block" : "none";
    };

    const clearActivePanes = () => panes.forEach(pane => setPaneActive(pane, false));
    
    const updateBodyOverflow = () => {
      if (!isMobile()) {
        body.style.overflow = "";
        return;
      }
      const isAnyVisible = Array.from(panes).some(pane => pane.style.display !== "none");
      body.style.overflow = isAnyVisible ? "hidden" : "";
    };

    if (isMobile()) clearActivePanes();
    updateBodyOverflow();

    const observer = new MutationObserver(updateBodyOverflow);
    panes.forEach(pane => {
      observer.observe(pane, {
        attributes: true,
        attributeFilter: ["style", "class"]
      });
    });

    closeButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        if (isMobile()) clearActivePanes();
      }, { passive: true });
    });

    let resizeTimeout;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(updateBodyOverflow, 100);
    }, { passive: true });
  }
  
  initTabSystem();
});
</script>

<!-- ========================================
     SCRIPT 7: BANNER CLOSE
     ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function initBannerClose() {
    const closeBtn = document.querySelector(".banner_close-icon");
    const banner = document.querySelector(".banner_wrap");
    
    if (closeBtn && banner) {
      closeBtn.addEventListener("click", () => {
        banner.style.display = "none";
      }, { passive: true });
    }
  }
  
  initBannerClose();
});
</script>

<!-- ========================================
     SCRIPT 8: CURRENT YEAR
     ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  function initCurrentYear() {
    const elements = document.querySelectorAll('[year]');
    const currentYear = new Date().getFullYear();
    elements.forEach(element => {
      element.textContent = currentYear;
    });
  }
  
  initCurrentYear();
});
</script>
</body></html>