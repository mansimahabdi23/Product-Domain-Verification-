<script>
    /* ===========================
   YOUTUBE API (GLOBAL)
=========================== */
    var ytPlayers = [];

    function onYouTubeIframeAPIReady() {
        if (!$('.testimonials').length) return;

        $('.testimonials iframe').each(function (i, iframe) {
            ytPlayers[i] = new YT.Player(iframe, {
                events: {
                    onStateChange: function (event) {
                        if (!$('.testimonials').hasClass('slick-initialized')) return;

                        if (event.data === YT.PlayerState.PLAYING) {
                            $('.testimonials').slick('slickPause');
                        } else if (
                            event.data === YT.PlayerState.PAUSED ||
                            event.data === YT.PlayerState.ENDED
                        ) {
                            $('.testimonials').slick('slickPlay');
                        }
                    }
                }
            });
        });
    }

    /* ===========================
       DOM READY
    =========================== */
    $(function () {

        /* ---------- Video lazy src ---------- */
        $('video[data-src]').each(function () {
            this.src = this.dataset.src;
        });

        /* ---------- Video autoplay (single clean block) ---------- */
        $('video').each(function () {
            this.muted = true;
            this.autoplay = true;
            this.playsInline = true;
            this.loop = true;
            this.preload = 'metadata';
            this.play().catch(() => { });
        });

        /* ---------- Enable YouTube JS API ---------- */
        $('.testimonials iframe').each(function () {
            let src = this.getAttribute('src') || '';
            if (!src.includes('enablejsapi=1')) {
                this.src = src + (src.includes('?') ? '&' : '?') + 'enablejsapi=1';
            }
        });

        /* ===========================
           SLICK SLIDERS (SAFE INIT)
        =========================== */

        if ($('.why-successive-career').length) {
            $('.why-successive-career').slick({
                speed: 5000,
                autoplay: true,
                autoplaySpeed: 0,
                cssEase: 'linear',
                infinite: true,
                slidesToShow: 4,
                arrows: false,
                responsive: [{
                    breakpoint: 1024,
                    settings: {
                        slidesToShow: 3
                    }
                },
                {
                    breakpoint: 600,
                    settings: {
                        slidesToShow: 2
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1
                    }
                }
                ]
            });
        }

        if ($('.case-study-slide').length && $('.gallery-slider-wrapper').length) {

            const $caseSlider = $('.case-study-slide');
            const $gallerySlider = $('.gallery-slider-wrapper');

            $caseSlider.slick({
                slidesToShow: 1,
                fade: true,
                autoplay: true,
                autoplaySpeed: 3000,
                speed: 600,
                asNavFor: '.gallery-slider-wrapper',
                prevArrow: '<button class="prevarrow-blog" type="button" aria-label="Previous slide"><img src="https://cdn.prod.website-files.com/67ee81925f563046d7c5247e/68cce201f7d0629fdd7a8408_arrow02.svg" alt="prev arrow"/></button>',
                nextArrow: '<button class="nextarrow-blog" type="button" aria-label="Next slide"><img src="https://cdn.prod.website-files.com/67ee81925f563046d7c5247e/68cce201894288fa825c1073_arrow01.svg" alt="next arrow" /></button>',
            });

            $gallerySlider.slick({
                slidesToShow: 1,
                arrows: false,
                asNavFor: '.case-study-slide',
                variableWidth: true,
            });

            // 🔥 Hover logic
            $gallerySlider.on('mouseenter', function () {
                $caseSlider.slick('slickPause');
            });

            $gallerySlider.on('mouseleave', function () {
                $caseSlider.slick('slickPlay');
            });
        }

        if ($('.testimonials').length) {

            $('.testimonials').on('init afterChange', function (e, slick, current) {
                $('.prevarrow-testimonials').prop('disabled', current === 0);
                $('.nextarrow-testimonials').prop(
                    'disabled',
                    current >= slick.slideCount - slick.options.slidesToShow
                );
            });

            $('.testimonials').slick({
                dots: false,
                infinite: false,
                speed: 2000,
                slidesToShow: 1,
                variableWidth: true,
                autoplaySpeed: 3000,
                cssEase: 'ease-in-out',
                autoplay: true,
                prevArrow: '<button class="prevarrow-testimonials" type="button" aria-label="Previous slide"><img src="https://cdn.prod.website-files.com/67ee81925f563046d7c5247e/68cce201f7d0629fdd7a8408_arrow02.svg" alt="prev arrow"/></button>',
                nextArrow: '<button class="nextarrow-testimonials" type="button" aria-label="Next slide"><img src="https://cdn.prod.website-files.com/67ee81925f563046d7c5247e/68cce201894288fa825c1073_arrow01.svg" alt="next arrow" /></button>',
                responsive: [{
                    breakpoint: 768,
                    settings: {
                        variableWidth: false
                    }
                }]
            });

            $('.testimonials').on('beforeChange', function () {
                $('.testimonials iframe').each(function () {
                    this.contentWindow?.postMessage(
                        '{"event":"command","func":"pauseVideo","args":""}',
                        '*'
                    );
                });
            });
        }

        /* ===========================
           NAVBAR BACKGROUND (OPTIMIZED)
        =========================== */
        const navbar = document.querySelector('.navbar.w-nav');
        if (navbar) {
            const updateNavbar = () => {
                navbar.style.backgroundColor =
                    window.scrollY > 67 || document.querySelector('.w--open') ?
                        'rgb(0,0,0)' :
                        'rgba(101,95,95,0.35)';
            };

            const observer = new MutationObserver(updateNavbar);
            observer.observe(navbar, {
                attributes: true
            });
            window.addEventListener('scroll', updateNavbar);
            updateNavbar();
        }

        /* ===========================
           HOVER TABS
        =========================== */
        function activateTabOnHover(toggle, dropdown, index) {
            document.querySelectorAll(toggle).forEach(el => {
                el.addEventListener('mouseenter', () => {
                    const container = el.closest(dropdown);
                    if (!container) return;

                    const tabs = container.querySelectorAll('.w-tab-link');
                    const panes = container.querySelectorAll('.w-tab-pane');

                    tabs.forEach(t => t.classList.remove('w--current'));
                    panes.forEach(p => p.classList.remove('w--tab-active'));

                    tabs[index]?.classList.add('w--current');
                    panes[index]?.classList.add('w--tab-active');
                });
            });
        }

        activateTabOnHover('.dropdown-toggle.services-menus', '.services-dropdown', 0);
        activateTabOnHover('.dropdown-toggle.industries-menus', '.industries-dropdown', 1);
        activateTabOnHover('.dropdown-toggle.about-menus', '.about-dropdown', 2);
        activateTabOnHover('.dropdown-toggle.resources-menus', '.resources-dropdown', 3);
        activateTabOnHover('.dropdown-toggle.accelerators-menus', '.accelerators-dropdown', 4);

        /* ===========================
           ACCESSIBILITY FIX
        =========================== */
        if ($('.industry-listings').hasClass('slick-initialized')) {
            $('.industry-listings').removeAttr('role');
            $('.industry-listings .slick-track').attr('role', 'list');
            $('.industry-listings .slick-slide').attr('role', 'listitem');
        }

    });

    (function () {
        var hostname = window.location.hostname;

        if (hostname === "successive.tech" || hostname === "www.successive.tech") {
            var script = document.createElement("script");
            script.src = "https://js.hsforms.net/forms/v2.js";
            script.defer = true;
            document.body.appendChild(script);
        }
    })();
</script></body></html>