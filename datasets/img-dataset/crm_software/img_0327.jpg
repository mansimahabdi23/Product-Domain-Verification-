    background-color: #eb9e24;
    margin-right:0;
}
a.isv-button-visit {
    background-color: #af3032;
}
.isv-product-modal {
  display: none; /* Hidden by default */
  position: fixed; /* Stay in place */
  z-index: 10; /* Sit on top */
  padding-top: 50px; /* Location of the box */
  left: 0;
  top: 0;
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  overflow: scroll; /* Enable scroll if needed */
  background-color: rgb(0,0,0); /* Fallback color */
  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
}

/* Modal Content */
.isv-product-modal-content {
    background-color: #fefefe;
    margin: auto;
    padding: 20px;
    border: 1px solid #888;
    width: 600px;
    min-width: 600px;
    padding-top: 180px;
    padding-bottom: 50px;
}

a.post-button-viewposts {
    background-color: #499645;
}

/* The Close Button */
.isv-product-close {
  color: #aaaaaa;
  float: right;
  font-size: 28px;
  font-weight: bold;
}


.isv-product-close:hover,
.isv-product-close:focus {
  color: #000;
  text-decoration: none;
  cursor: pointer;
}
.isv-product-modal-content .erf-container{
    position:inherit!important;
}

#ask_author p, #ask_author_link a, #ask_author_link a:active, #ask_author_link a:visited {
