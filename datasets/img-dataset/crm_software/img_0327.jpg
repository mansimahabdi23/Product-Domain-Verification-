    padding-bottom: 8px;
    min-width: 100%;
	margin-bottom:25px;
}

table.data td.data-head {
	background-color: #333;
	color: #fff;
	font-weight: bold;
	text-align: center;
}

.data {
	margin-top: 20px;
}

div.whitepaper_form {
	width: 80%;
	margin: 15px auto 10px;
	border-color: #1b558d;
	border-width: 1px;
	border-style: solid;
	color: #000;
	font-family: Arial,Helvetica,sans-serif;
}

.whitepaper_form .heading {
	background: url(/themes/erp-astra-child/images/xwpnav1_bckgrnd.png.pagespeed.ic.ZkVqyBqOZj.png) repeat-x scroll left top #001938;
}

.whitepaper_form h4 {
	font-size: 14px;
	line-height: 1;
	font-weight: 700;
	padding: 8px 15px;
	color: #fff;
}
.whitepaper_form_bg {
	background-color: #f5f5f5;
	padding: 10px 0 0;
}

.whitepaper_form {
	color: #000;
	font-family: Arial,Helvetica,sans-serif;
}
.whitepaper_form_wait {
	background-color: #f5f5f5;
	padding: 15px;
	text-align: center;
}

#frm_contact table tr.phone {
	display: none;
}
.whitepaper_form table td.wp_label {
	text-align: right;
	padding: 4px 5px 2px 15px;
}
.whitepaper_form table td {
	font-size: 13px;
}
.whitepaper_form table td.wp_label {
	text-align: right;
}
input.wp_form, select.wp_form {
	width: 100%;
}
td.wp_submit {
	padding: 5px 0 15px;
}

.erp-members-list {
	text-align:center;
}

.blog-layout-1 {
	width: 100%;
