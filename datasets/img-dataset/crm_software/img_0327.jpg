		<style id="wp-custom-css">
			/*Fix Ombed Issue*/
/* Final override for Astra embeds */
.yt-embed {
  position: relative;
  padding-top: 56.25%; /* 16:9 aspect ratio */
  height: 0;
  overflow: hidden;
  max-width: 100%;
}

.yt-embed iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
}

/* Fix for oEmbed video overlap */
/* Universal fix for oEmbed video overlap on all post types */
article .entry-content .ast-oembed-container {
    position: relative !important;
    padding-bottom: 56.25% !important; /* This creates the 16:9 aspect ratio */
    height: 0 !important;
    overflow: hidden; /* Ensures nothing spills out */
}

/* This makes the actual video fill the container we just shaped */
article .entry-content .ast-oembed-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

/* 1) Neutralize Astra's wrapper so it stops forcing its own height logic */
.entry-content .ast-oembed-container {
  position: static !important;   /* beat Astra's position:relative */
  padding: 0 !important;         /* remove the 56.25% padding trick */
  height: auto !important;       /* override Astra's trailing height:auto */
  overflow: visible !important;  /* unclip children */
  max-width: 100%;
}

/* 2) Make YouTube iframes responsive with modern CSS (no wrapper needed) */
.entry-content iframe[src*="youtube.com"],
.entry-content iframe[src*="youtube-nocookie.com"] {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;          /* modern, reliable */
  height: auto;                  /* let aspect-ratio drive the height */
  border: 0;
}

/* (Optional) Cover Vimeo too */
.entry-content iframe[src*="player.vimeo.com"] {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  height: auto;
  border: 0;
}



/*
Single Column on Profile Page*/
@media (min-width: 922px) {

.member-page.content-area  {
        width: 100% !important;
border-right: none !important;
    }
}

/* ???? Force logo to a readable size on small screens */

.widget_custom_html > *, .widget_text > *, .widget_links > *, .widget_categories > *,
.widget_media_image > *,
.widget_il_top_posts > * {
  display: block !important;
  width: 277.998px !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* make sidebar display below the content on mobile */
@media (max-width: 768px) {
  .widget_custom_html > *, .widget_text > *, .widget_links > *, .widget_categories > *, .widget_media_image > *, .widget_il_top_posts > * {
    width: 100% !important;
    max-width: 400px;
  }

}

.entry-meta {
    line-height: 1.45;
    color: #0274BE;
    display: inline-block;
}

.rss_sidebar {
	width: 274px; 
}

@media (max-width: 768px) {
  .custom-logo {
    height: auto !important;
    max-height: none !important;
    width: 100% !important;
    max-width: 300px; /* or 90% if you want it fluid */
  }
	
  .rss_sidebar {
	  width: 100%;
		max-width: 400px;
  }
	
	.textwidget img { width: 100%;
	}
	

  .site-logo-img {
    display: flex;
    justify-content: flex-start;  /* or center if preferred */
    align-items: center;
  }
}

.entry-title.ast-blog-single-element {
	display: none !important
}


/*Remove underlines on links*/
a:where(:not(.wp-element-button)) {
    text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* fix for review spacing */
.wpcr3_review_author {
  margin-left: 6px;
}

.wpcr3_caps {
  margin-left: 6px;
}

.wpcr3_item_name {
  margin-left: 6px;
}

/* Hide Elements on Post Pages */
.post-type-post div#wpcr3-meta-box {
    display: none !important;
}


.authorarchiveTitle {
    margin-bottom: 30px;
}

.ast-header-html > div > p {
	font-size: 15px !important;
	padding-left: 90px
}

.ast-article-post > h1 > a {
	font-size: 32px !important;
}

.youtube {
    background-color: #000;
    margin-bottom: 30px;
    position: relative;
    padding-top: 56.25%;
    overflow: hidden;
    cursor: pointer;
}
.youtube img {
    width: 100%;
    top: -16.84%;
    left: 0;
    opacity: 0.7;
}
.youtube .play-button {
    width: 90px;
    height: 60px;
    background-color: #333;
    box-shadow: 0 0 30px rgba( 0,0,0,0.6 );
    z-index: 1;
    opacity: 0.8;
    border-radius: 6px;
}
.youtube .play-button:before {
    content: "";
    border-style: solid;
    border-width: 15px 0 15px 26.0px;
    border-color: transparent transparent transparent #fff;
}
.youtube img,
.youtube .play-button {
    cursor: pointer;
}
.youtube img,
.youtube iframe,
.youtube .play-button,
.youtube .play-button:before {
    position: absolute;
}
.youtube .play-button,
.youtube .play-button:before {
    top: 50%;
    left: 50%;
    transform: translate3d( -50%, -50%, 0 );
}
.youtube iframe {
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
}

.entry-content p {
	font-size: 110%;
}

/**
Theme Name: CRM Software Blog Theme
Author: Interactive Limited
Author URI: https://interactivelimited.com
Description: Astra is the fastest, fully customizable & beautiful theme suitable for blogs, personal portfolios and business websites. It is very lightweight (less than 50KB on frontend) and offers unparalleled speed. Built with SEO in mind, Astra comes with schema.org code integrated so search engines will love your site. Astra offers plenty of sidebar options and widget areas giving you a full control for customizations. Furthermore, we have included special features and templates so feel free to choose any of your favorite page builder plugin to create pages flexibly. Some of the other features: # WooCommerce Ready # Responsive # Compatible with major plugins # Translation Ready # Extendible with premium addons # Regularly updated # Designed, Developed, Maintained & Supported by Brainstorm Force. Looking for a perfect base theme? Look no further. Astra is fast, fully customizable and beautiful theme!
Version: 1.0.0
License: GNU General Public License v2 or later
License URI: http://www.gnu.org/licenses/gpl-2.0.html
Text Domain: crm-software-blog-theme
Template: astra
*/

/*Mobile Adjustments*/
.ast-header-break-point .site-branding img, .ast-header-break-point #masthead .site-logo-img .custom-logo-link img {
	max-width: 100%;
}

@media only screen and (max-width: 600px) {
td, th {
	padding: 8px;
	text-align: left;
	border-width: 0 1px 1px 0;
	max-width: 130px;
}	
	
} 

/*Blog Title Elements*/
.blog_logo {
	min-width: 80px;
	height: 80px;
	overflow: hidden;
	margin-right:10px;
	float:left;
}

.blog_title {
	float:left;
}

.archive-header, .erf-content-above {
	font-size: 25px;
	margin-bottom: 30px;
	border-bottom-color: #499645;
	border-bottom-style: solid;
	border-bottom-width: 3px;
	line-height: 33px;
	padding-bottom: 10px;
}

.blog_title_container .entry-title{
	/*display:flex;*/
    width: calc(100% - 90px) !important;
}

/*Sidebar Elements*/
#iquote, #directory-button, #directory-button-1, #directory-button-2,#directory-button-3  {
    background: #dfdfdf url(images/iquote_gradient.png) bottom repeat-x;
    -webkit-border-radius: 5px;
    -moz-border-radius: 5px;
    border: 1px solid #937d27;
    width: 274px;
    height: 60px;
    margin-bottom: 20px;
    padding-top: 5px;
    text-align: center;
    cursor: pointer;
	font-size:18px;
	font-weight:700;
	line-height:21.6px;
	outline-color: rgb(0, 31, 69);
}

#iquote a {
    color: rgb(0, 31, 69);
}

.page-item {
	font-size: 20px;
	list-style: none;
	margin-bottom: 15px;
	padding-bottom: 15px;
	/*border-bottom-color: grey;
	border-bottom-width: 3px;
	border-bottom-style: solid;*/
}

.page-item-no-image {
		font-size: 20px;
	list-style: none;
	margin-bottom: 15px;
	padding-bottom: 15px;
	border-bottom: none;
}

.page-item-logo{
	border-width: 0px; 
	max-height:60px
}

.rss {
    background: #dfdfdf url(images/rss_gradient.png) bottom repeat-x;
    -webkit-border-radius: 5px;
    -moz-border-radius: 5px;
    border: 1px solid #937d27;
    width: 100%;
    margin: 0;
    padding: 0 10px 0 10px;
	max-height: 110px;
}
.rss .left {
    float: left;
    width: 75px;
    padding: 5px 0;
        padding-top: 5px;
        padding-right: 0px;
        padding-bottom: 5px;
        padding-left: 0px;
}

.rss .right {
	float: right;
	width: 150px;
	padding: 5px 0;
}

.right p {
	margin-bottom: 0px;
}

.rss .right .email {
	border: 1px solid #8199a3;
	height: 20px;
	width: 145px;
	margin-bottom: 8px;
}

.rss .right .submit_email {
	background: #fff url(images/more_link.png) repeat-x;
	border: 1px solid #05346e;
	-webkit-border-radius: 5px;
	-moz-border-radius: 5px;
	margin: 0 0 0 2px;
	padding: 3px 10px;
	font-size: 13px;
	font-weight: 700;
	color: #fff;
	cursor: pointer;
}

#sidebar ul p, #sidebar ul select {
    margin: 5px 0 8px;
        margin-top: 5px;
        margin-right: 0px;
        margin-bottom: 8px;
        margin-left: 0px;
}
	/*sidebar Select Language*/
.execphpwidget select {
	padding: 5px 0 5px 0;
}

.execphpwidget input {
	background-color: white;
	padding: 5px 5px;
	color: rgb(2, 116, 190);
	border-color: rgb(2, 116, 190);
}

.lable-filters {
    font-size: 12px;
    font-weight: 500;
}

.postform {
    font-size: 13px;
    padding: 1px;
}

.grid_1, .grid_2, .grid_3, .grid_4, .grid_5, .grid_6, .grid_7, .grid_8, .grid_9, .grid_10, .grid_11, .grid_12, .grid_13, .grid_14, .grid_15, .grid_16 {
